{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auditeduca.github.io/Calculadoras-de-Enfermagem/schema/site.schema.json",
  "title": "Configuração do Site - Calculadoras de Enfermagem",
  "description": "Fonte única de verdade para identidade, navegação, idiomas e rodapé. Os componentes header-v4.html e footer-v4.html são gerados a partir deste arquivo por tools/gerar_componentes.py.",
  "type": "object",
  "required": ["site", "nav", "languages", "footer"],
  "properties": {
    "$schema": { "type": "string" },
    "site": {
      "type": "object",
      "required": ["name", "baseUrl", "logoHeader", "logoFooter"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fullName": { "type": "string" },
        "baseUrl": { "type": "string", "pattern": "^https?://" },
        "logoHeader": { "type": "string" },
        "logoFooter": { "type": "string" },
        "favicon": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "versionDate": { "type": "string" },
        "social": { "type": "object" }
      }
    },
    "nav": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "label"],
        "properties": {
          "type": { "type": "string", "enum": ["link", "mega"] },
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string" },
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "promoImage": { "type": "string" },
          "tabs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "links"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string" },
                "links": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/definitions/navLink" }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "link" } } },
            "then": { "required": ["href"] }
          },
          {
            "if": { "properties": { "type": { "const": "mega" } } },
            "then": { "required": ["id", "tabs"] }
          }
        ]
      }
    },
    "languages": {
      "type": "object",
      "required": ["default", "groups"],
      "properties": {
        "default": { "type": "string" },
        "promoImage": { "type": "string" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "items"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "label", "flag"],
                  "properties": {
                    "code": { "type": "string" },
                    "label": { "type": "string" },
                    "flag": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "required": ["columns", "legalLinks", "social"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "links"],
            "properties": {
              "title": { "type": "string" },
              "links": {
                "type": "array",
                "items": { "$ref": "#/definitions/navLink" }
              }
            }
          }
        },
        "commitment": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        "legalLinks": {
          "type": "array",
          "items": { "$ref": "#/definitions/navLink" }
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "icon", "url"],
            "properties": {
              "name": { "type": "string" },
              "icon": { "type": "string" },
              "url": { "type": "string", "pattern": "^https?://" }
            }
          }
        },
        "copyrightName": { "type": "string" }
      }
    }
  },
  "definitions": {
    "navLink": {
      "type": "object",
      "required": ["text", "href"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "href": {
          "type": "string",
          "description": "Rota relativa à raiz do site (ex.: missao.html, calculadoras/apgar/) ou URL absoluta."
        }
      }
    }
  }
}
