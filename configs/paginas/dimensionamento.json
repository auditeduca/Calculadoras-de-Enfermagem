  "form": {
    "sections": [
      {
        "title": "Dados do Paciente",
        "fields": [
          {
            "id": "patientName",
            "type": "text",
            "label": "Nome do Paciente",
            "placeholder": "Nome completo (opcional)",
            "optional": true
          },
          {
            "id": "patientBirthdate",
            "type": "date",
            "label": "Data de Nascimento",
            "optional": true
          }
        ]
      },
      {
        "title": "Parâmetros",
        "fields": [
          {
            "id": "cargaHoraria",
            "type": "number",
            "label": "Carga horária semanal",
            "placeholder": "Ex: 36",
            "unit": "h/semana",
            "required": true,
            "min": 0,
            "step": "1"
          },
          {
            "id": "numCM",
            "type": "number",
            "label": "Pacientes de cuidado mínimo",
            "placeholder": "Ex: 5",
            "unit": "pacientes",
            "required": false,
            "min": 0,
            "step": "1"
          },
          {
            "id": "numCI",
            "type": "number",
            "label": "Pacientes de cuidado intermediário",
            "placeholder": "Ex: 8",
            "unit": "pacientes",
            "required": false,
            "min": 0,
            "step": "1"
          },
          {
            "id": "numCAD",
            "type": "number",
            "label": "Pacientes de alta dependência",
            "placeholder": "Ex: 3",
            "unit": "pacientes",
            "required": false,
            "min": 0,
            "step": "1"
          },
          {
            "id": "numCSI",
            "type": "number",
            "label": "Pacientes semi-intensivos",
            "placeholder": "Ex: 0",
            "unit": "pacientes",
            "required": false,
            "min": 0,
            "step": "1"
          }
        ]
      }
    ],
    "buttons": {
      "calculate": {
        "label": "Calcular",
        "icon": "fa-calculator",
        "action": "calculate"
      },
      "reset": {
        "label": "Limpar",
        "icon": "fa-rotate-left",
        "action": "reset"
      }
    }
  },
  "calculation": {
    "mode": "formula",
    "formula": "pessoal = (numCM * 4 + numCI * 6 + numCAD * 10 + numCSI * 10) * 7 / cargaHoraria",
    "result": {
      "label": "Quadro de pessoal",
      "unit": "profissionais",
      "decimals": 1,
      "key": "pessoal",
      "interpretationOf": "pessoal"
    },
    "interpretation": [
      {
        "max": 100000,
        "label": "Quadro estimado",
        "color": "text-nurse-primary",
        "bg": "bg-slate-50",
        "conduct": "Horas de cuidado por 24 h: mínimo 4, intermediário 6, alta dependência 10, semi-intensivo 10. O quadro divide o total semanal pela carga horária."
      }
    ],
    "audit": {
      "title": "Auditoria",
      "steps": [
        {
          "label": "Fórmula",
          "fixedValue": "(Σ pacientes × horas) × 7 / carga horária",
          "icon": "fa-calculator"
        },
        {
          "label": "Profissionais",
          "sourceField": "pessoal",
          "icon": "fa-user-nurse"
        }
      ]
    },
