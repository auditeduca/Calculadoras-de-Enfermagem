        "label": "Limpar",
        "icon": "fa-rotate-left",
        "action": "reset"
      }
    }
  },
  "calculation": {
    "mode": "formula",
    "formula": "volume = heparinaPrescricao * heparinaVolume / heparinaConcentracao",
    "result": {
      "label": "Volume a aspirar",
      "unit": "mL",
      "decimals": 2,
      "key": "volume",
      "interpretationOf": "volume"
    },
