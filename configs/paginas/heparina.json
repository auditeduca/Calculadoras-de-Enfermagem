      },
      {
        "title": "Parâmetros",
        "fields": [
          {
            "id": "heparinaConcentracao",
            "type": "number",
            "label": "Quantidade no frasco",
            "placeholder": "Ex: 5000",
            "unit": "UI",
            "required": true,
            "min": 0,
            "step": "any"
          },
          {
            "id": "heparinaVolume",
            "type": "number",
            "label": "Volume do frasco",
            "placeholder": "Ex: 5",
            "unit": "mL",
            "required": true,
            "min": 0,
            "step": "0.1"
          },
          {
            "id": "heparinaPrescricao",
            "type": "number",
            "label": "Prescrição",
            "placeholder": "Ex: 2500",
            "unit": "UI",
            "required": true,
            "min": 0,
            "step": "any"
          }
        ]
      }
    ],
    "buttons": {
      "calculate": {
        "label": "Calcular",
        "icon": "fa-calculator",
        "action": "calculate"
