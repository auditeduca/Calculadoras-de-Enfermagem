        "title": "Avaliação",
        "fields": [
          {
            "id": "face",
            "type": "select",
            "label": "Face",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — sem expressão especial ou sorriso",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — careta ocasional ou sobrancelha franzida",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — queixo trêmulo, mandíbula cerrada",
                "score": 2
              }
            ]
          },
          {
            "id": "pernas",
            "type": "select",
            "label": "Pernas",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — relaxadas",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — inquietas ou tensas",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — chutando ou encolhidas",
                "score": 2
              }
            ]
          },
          {
            "id": "atividade",
            "type": "select",
            "label": "Atividade",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — quieto, posição normal",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — contorce-se, muda de posição",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — em arco, rígido ou agitado",
                "score": 2
              }
            ]
          },
          {
            "id": "choro",
            "type": "select",
            "label": "Choro",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — sem choro",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — geme ou choraminga",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — choro contínuo, grito ou soluço",
                "score": 2
              }
            ]
          },
          {
            "id": "consolo",
            "type": "select",
            "label": "Consolabilidade",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — contente, relaxado",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — acalmado por toque ou voz",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — difícil de consolar",
                "score": 2
              }
            ]
          }
        ]
