  "calculation": {
    "formula": "apgar1 = frequencia1 + respiracao1 + tonus1 + reflexo1 + cor1; apgar5 = frequencia5 + respiracao5 + tonus5 + reflexo5 + cor5",
    "result": {
      "label": "Apgar 1' / 5'",
      "unit": "pontos",
      "decimals": 0,
      "keys": [
        "apgar1",
        "apgar5"
      ],
      "key": "apgar5",
      "interpretationOf": "apgar5"
    },
