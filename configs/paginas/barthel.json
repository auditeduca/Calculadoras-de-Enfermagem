  "form": {
    "sections": [
      {
        "title": "Dados do Paciente",
        "fields": [
          {
            "id": "patientName",
            "type": "text",
            "label": "Nome do Paciente",
            "placeholder": "Nome completo (opcional)",
            "optional": true,
            "tooltip": "Identificação do paciente para fins de registro.",
            "libras": false
          },
          {
            "id": "patientBirthdate",
            "type": "date",
            "label": "Data de Nascimento",
            "optional": true,
            "tooltip": "Para cálculo de idade e contextualização clínica.",
            "libras": false
          }
        ]
      },
      {
        "title": "Atividades de Vida Diária (AVD)",
        "fields": [
          {
            "id": "alimentacao",
            "type": "select",
            "label": "Alimentação",
            "icon": "fa-utensils",
            "maxScore": 10,
            "options": [
              {
                "value": 0,
                "label": "0 — Incapaz (necessita ser alimentado)"
              },
              {
                "value": 5,
                "label": "5 — Necessita de ajuda (cortar alimentos, etc.)"
              },
              {
                "value": 10,
                "label": "10 — Independente (come sem ajuda)"
              }
            ],
            "default": 10,
            "required": true,
            "tooltip": "Capacidade de se alimentar usando utensílios. Inclui cortar alimentos se necessário.",
            "libras": false
          },
          {
            "id": "banho",
            "type": "select",
            "label": "Banho",
            "icon": "fa-shower",
            "maxScore": 5,
            "options": [
              {
                "value": 0,
                "label": "0 — Dependente"
              },
              {
                "value": 5,
                "label": "5 — Independente (entra/sai do banho sem ajuda)"
              }
            ],
            "default": 5,
            "required": true,
            "tooltip": "Capacidade de tomar banho sem supervisão.",
            "libras": false
          },
          {
            "id": "higiene",
            "type": "select",
            "label": "Higiene Pessoal",
            "icon": "fa-face-smile",
            "maxScore": 5,
            "options": [
              {
                "value": 0,
                "label": "0 — Dependente"
              },
              {
                "value": 5,
                "label": "5 — Independente (rosto, cabelo, dentes, aparência)"
              }
            ],
            "default": 5,
            "required": true,
            "tooltip": "Higiene do rosto, cabelo, dentes e uso de máquina de barbear.",
            "libras": false
          },
          {
            "id": "vestuario",
            "type": "select",
            "label": "Vestuário",
            "icon": "fa-shirt",
            "maxScore": 10,
            "options": [
              {
                "value": 0,
                "label": "0 — Dependente"
              },
              {
                "value": 5,
                "label": "5 — Necessita de ajuda (metade das tarefas)"
              },
              {
                "value": 10,
                "label": "10 — Independente (inclui sapatos, fechos, cintos)"
              }
            ],
            "default": 10,
            "required": true,
            "tooltip": "Capacidade de vestir e despir. Inclui sapatos e fechos.",
            "libras": false
          },
          {
            "id": "intestino",
            "type": "select",
            "label": "Controle Intestinal",
            "icon": "fa-circle-check",
            "maxScore": 10,
            "options": [
              {
                "value": 0,
                "label": "0 — Incontinente (ou necessita enema)"
              },
              {
                "value": 5,
                "label": "5 — Acidente ocasional (máx. 1x/semana)"
              },
              {
                "value": 10,
                "label": "10 — Continente"
              }
            ],
            "default": 10,
            "required": true,
            "tooltip": "Controle da função intestinal. Registrar semana anterior.",
            "libras": false
          },
          {
            "id": "bexiga",
            "type": "select",
            "label": "Controle Vesical",
            "icon": "fa-droplet",
            "maxScore": 10,
            "options": [
              {
                "value": 0,
                "label": "0 — Incontinente ou sondado sem controle"
              },
              {
                "value": 5,
                "label": "5 — Acidente ocasional (máx. 1x/24h)"
              },
              {
                "value": 10,
                "label": "10 — Continente (por mais de 7 dias)"
              }
            ],
            "default": 10,
            "required": true,
            "tooltip": "Controle urinário. Inclui uso de sonda com controle.",
            "libras": false
          },
          {
            "id": "banheiro",
            "type": "select",
            "label": "Uso do Banheiro (WC)",
            "icon": "fa-restroom",
            "maxScore": 10,
            "options": [
              {
                "value": 0,
                "label": "0 — Dependente"
              },
              {
                "value": 5,
                "label": "5 — Necessita de ajuda (equilíbrio, roupas)"
              },
              {
                "value": 10,
                "label": "10 — Independente (higiene e roupas)"
              }
            ],
            "default": 10,
            "required": true,
            "tooltip": "Uso do banheiro. Inclui se desviar, higiene íntima e roupas.",
            "libras": false
          },
          {
            "id": "transferencia",
            "type": "select",
            "label": "Transferência Cadeira–Cama",
            "icon": "fa-arrows-up-down",
            "maxScore": 15,
            "options": [
              {
                "value": 0,
                "label": "0 — Incapaz (sem equilíbrio sentado)"
              },
              {
                "value": 5,
                "label": "5 — Precisa de ajuda maior (2 pessoas)"
              },
              {
                "value": 10,
                "label": "10 — Precisa de ajuda menor (1 pessoa)"
              },
              {
                "value": 15,
                "label": "15 — Independente"
              }
            ],
            "default": 15,
            "required": true,
            "tooltip": "Transferência da cadeira de rodas para a cama e retorno.",
            "libras": false
          },
          {
            "id": "deambulacao",
            "type": "select",
            "label": "Deambulação",
            "icon": "fa-person-walking",
            "maxScore": 15,
            "options": [
              {
                "value": 0,
                "label": "0 — Imóvel"
              },
              {
                "value": 5,
                "label": "5 — Independente em cadeira de rodas (> 50m)"
              },
              {
                "value": 10,
                "label": "10 — Anda com ajuda (1 pessoa, > 50m)"
              },
              {
                "value": 15,
                "label": "15 — Independente (podendo usar andador > 50m)"
              }
            ],
            "default": 15,
            "required": true,
            "tooltip": "Capacidade de deambular no andar. Distância mínima de 50 metros.",
            "libras": false
          },
          {
            "id": "escadas",
            "type": "select",
            "label": "Escadas",
            "icon": "fa-stairs",
            "maxScore": 10,
            "options": [
              {
                "value": 0,
                "label": "0 — Incapaz"
              },
              {
                "value": 5,
                "label": "5 — Necessita de ajuda (física ou verbal)"
              },
              {
                "value": 10,
                "label": "10 — Independente (pode usar apoio ou corrimão)"
              }
            ],
            "default": 10,
            "required": true,
            "tooltip": "Capacidade de subir e descer um lance de escadas.",
            "libras": false
          }
        ]
      }
    ],
