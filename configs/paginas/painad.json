        "fields": [
          {
            "id": "resp",
            "type": "select",
            "label": "Respiração",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — normal",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — ocasionalmente difícil",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — ruidosa, rápida ou Cheyne-Stokes",
                "score": 2
              }
            ]
          },
          {
            "id": "vocal",
            "type": "select",
            "label": "Vocalização",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — nenhuma",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — gemido ou fala negativa ocasional",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — chamado repetido, gemido alto ou choro",
                "score": 2
              }
            ]
          },
          {
            "id": "face",
            "type": "select",
            "label": "Expressão facial",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — sorrindo ou inexpressiva",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — triste, assustada ou carrancuda",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — careta",
                "score": 2
              }
            ]
          },
          {
            "id": "corpo",
            "type": "select",
            "label": "Linguagem corporal",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — relaxado",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — tenso, inquieto",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — rígido, punhos cerrados ou agressivo",
                "score": 2
              }
            ]
          },
          {
            "id": "consolo",
            "type": "select",
            "label": "Consolabilidade",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — não precisa",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — distraído por voz ou toque",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — impossível consolar",
                "score": 2
              }
            ]
          }
        ]
      }
    ]
