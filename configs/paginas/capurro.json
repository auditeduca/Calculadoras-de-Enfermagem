  "calculation": {
    "mode": "formula",
    "formula": "soma = pele + orelha + glandula + mamilo + pregas; dias = 204 + soma; semanas = dias / 7",
    "result": {
      "label": "Método de Capurro somático",
      "unit": "semanas",
      "decimals": 1,
      "key": "semanas",
      "interpretationOf": "semanas"
    },
