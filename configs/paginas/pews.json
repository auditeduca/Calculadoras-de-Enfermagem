  "form": {
    "sections": [
      {
        "title": "Dados do paciente",
        "fields": [
          {
            "id": "patientName",
            "type": "text",
            "label": "Nome do paciente",
            "placeholder": "Opcional",
            "optional": true
          },
          {
            "id": "patientBirthdate",
            "type": "date",
            "label": "Data de nascimento",
            "optional": true
          }
        ]
      },
      {
        "title": "Avaliação",
        "fields": [
          {
            "id": "comportamento",
            "type": "select",
            "label": "Comportamento",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — brincando ou apropriado",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — sonolento",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — irritável",
                "score": 2
              },
              {
                "value": 3,
                "label": "3 — letárgico, confuso ou resposta reduzida à dor",
                "score": 3
              }
            ]
          },
          {
            "id": "circulacao",
            "type": "select",
            "label": "Circulação",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — rosado, enchimento capilar 1 a 2 s",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — pálido ou enchimento de 3 s",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — acinzentado ou enchimento de 4 s, ou taquicardia acima do esperado",
                "score": 2
              },
              {
                "value": 3,
                "label": "3 — moteado, acinzentado, enchimento de 5 s ou mais, ou bradicardia",
                "score": 3
              }
            ]
          },
          {
            "id": "respiracao",
            "type": "select",
            "label": "Respiração",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — normal para a idade, sem esforço",
                "score": 0
              },
              {
                "value": 1,
                "label": "1 — mais de 10 acima do normal ou uso leve de músculo acessório",
                "score": 1
              },
              {
                "value": 2,
                "label": "2 — mais de 20 acima do normal, retração ou 50% ou mais de oxigênio",
                "score": 2
              },
              {
                "value": 3,
                "label": "3 — mais de 5 abaixo do normal, gemido, estridor ou 50% ou mais com retração grave",
                "score": 3
              }
            ]
          },
          {
            "id": "extra",
            "type": "select",
            "label": "Nebulização ou vômito",
            "required": true,
            "options": [
              {
                "value": 0,
                "label": "0 — não",
                "score": 0
              },
              {
                "value": 2,
                "label": "2 — nebulização a cada 15 minutos ou vômito persistente",
                "score": 2
              }
            ]
          }
        ]
      }
    ]
  },
