        "label": "Limpar",
        "icon": "fa-rotate-left",
        "action": "reset"
      }
    }
  },
  "calculation": {
    "mode": "formula",
    "formula": "imc = peso / (altura * altura)",
    "result": {
      "label": "IMC",
      "unit": "kg/m²",
      "decimals": 1,
      "key": "imc",
      "interpretationOf": "imc"
    },
