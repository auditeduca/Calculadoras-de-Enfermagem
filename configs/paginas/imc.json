  "form": {
    "sections": [
      {
        "title": "Dados do Paciente",
        "fields": [
          {
            "id": "patientName",
            "type": "text",
            "label": "Nome do Paciente",
            "placeholder": "Nome completo (opcional)",
            "optional": true
          },
          {
            "id": "patientBirthdate",
            "type": "date",
            "label": "Data de Nascimento",
            "optional": true
          }
        ]
      },
      {
        "title": "Parâmetros",
        "fields": [
          {
            "id": "peso",
            "type": "number",
            "label": "Peso",
            "placeholder": "Ex: 70",
            "unit": "kg",
            "required": true,
            "min": 0,
            "step": "0.1"
          },
          {
            "id": "altura",
            "type": "number",
            "label": "Altura",
            "placeholder": "Ex: 1.70",
            "unit": "m",
            "required": true,
            "min": 0.4,
            "max": 2.5,
            "step": 0.01
          }
        ]
      }
    ],
    "buttons": {
      "calculate": {
        "label": "Calcular",
        "icon": "fa-calculator",
        "action": "calculate"
