  "calculation": {
    "mode": "formula",
    "formula": "total = postura + punho + braco + popliteo + xale + calcaneo + pele + lanugo + plantar + mama + olho + genitalia; semanas = 24 + total * 0.4",
    "result": {
      "label": "New Ballard Score",
      "unit": "semanas",
      "decimals": 1,
      "key": "semanas",
      "interpretationOf": "semanas"
    },
