  "form": {
    "sections": [
      {
        "title": "Dados do Paciente",
        "fields": [
          {
            "id": "patientName",
            "type": "text",
            "label": "Nome do Paciente",
            "placeholder": "Nome completo (opcional)",
            "optional": true,
            "tooltip": "Identificação do paciente para fins de registro.",
            "libras": false
          },
          {
            "id": "patientBirthdate",
            "type": "date",
            "label": "Data de Nascimento",
            "optional": true,
            "tooltip": "Para cálculo de idade e verificação de faixa etária.",
            "libras": false
          }
        ]
      },
      {
        "title": "Parâmetros Clínicos",
        "fields": [
          {
            "id": "activity",
            "type": "select",
            "label": "Atividade",
            "options": [
              {
                "value": 2,
                "label": "Move 4 extremidades voluntariamente ou sob comando"
              },
              {
                "value": 1,
                "label": "Move 2 extremidades"
              },
              {
                "value": 0,
                "label": "Não move extremidades"
              }
            ],
            "default": 2,
            "required": true,
            "tooltip": "Avaliar capacidade motora.",
            "libras": false
          },
          {
            "id": "respiration",
            "type": "select",
            "label": "Respiração",
            "options": [
              {
                "value": 2,
                "label": "Respira profundamente e tosse livremente"
              },
              {
                "value": 1,
                "label": "Dispneia ou respiração superficial limitada"
              },
              {
                "value": 0,
                "label": "Apneia"
              }
            ],
            "default": 2,
            "required": true,
            "tooltip": "Avaliar padrão respiratório.",
            "libras": false
          },
          {
            "id": "circulation",
            "type": "select",
            "label": "Circulação",
            "options": [
              {
                "value": 2,
                "label": "PA dentro de 20 mmHg do nível pré-anestésico"
              },
              {
                "value": 1,
                "label": "PA dentro de 20-50 mmHg do nível pré-anestésico"
              },
              {
                "value": 0,
                "label": "PA fora de 50 mmHg do nível pré-anestésico"
              }
            ],
            "default": 2,
            "required": true,
            "tooltip": "Comparar pressão arterial com a pré-anestésica.",
            "libras": false
          },
          {
            "id": "consciousness",
            "type": "select",
            "label": "Consciência",
            "options": [
              {
                "value": 2,
                "label": "Totalmente acordado"
              },
              {
                "value": 1,
                "label": "Desperta ao ser chamado"
              },
              {
                "value": 0,
                "label": "Não responde"
              }
            ],
            "default": 2,
            "required": true,
            "tooltip": "Nível de consciência.",
            "libras": false
          },
          {
            "id": "oxygenation",
            "type": "select",
            "label": "Saturação de Oxigênio",
            "options": [
              {
                "value": 2,
                "label": "SpO2 > 92% em ar ambiente"
              },
              {
                "value": 1,
                "label": "SpO2 > 90% com suplemento de O2"
              },
              {
                "value": 0,
                "label": "SpO2 < 90% mesmo com suplemento"
              }
            ],
            "default": 2,
            "required": true,
            "tooltip": "Saturação de oxigênio.",
            "libras": false
          }
        ]
      }
    ],
    "buttons": {
      "calculate": {
        "label": "Avaliar",
        "icon": "fa-check",
        "action": "calculate"
      },
      "reset": {
        "label": "Limpar",
        "icon": "fa-rotate-left",
        "action": "reset"
      }
    }
  },
  "calculation": {
    "formula": "total = activity + respiration + circulation + consciousness + oxygenation",
    "result": {
      "label": "Pontuação Aldrete",
      "unit": "pontos",
      "decimals": 0,
      "key": "total",
      "interpretationOf": "total"
    },
    "audit": {
      "title": "Auditoria da Avaliação",
      "steps": [
        {
          "label": "Atividade",
          "sourceField": "activity",
          "icon": "fa-person-walking"
        },
        {
          "label": "Respiração",
          "sourceField": "respiration",
          "icon": "fa-lungs"
        },
        {
          "label": "Circulação",
          "sourceField": "circulation",
          "icon": "fa-heart-pulse"
        },
        {
          "label": "Consciência",
          "sourceField": "consciousness",
          "icon": "fa-brain"
        },
        {
          "label": "Oxigenação",
          "sourceField": "oxygenation",
          "icon": "fa-wind"
        },
        {
          "label": "Pontuação Total",
          "sourceField": "total",
          "suffix": "pontos",
          "icon": "fa-star"
        }
      ]
    },
